<?xml version="1.0" encoding="utf-8"?>
<applicationTemplate type="application-template">
  <id>Aryzac.Aspire.Application.Template</id>
  <version>1.0.0</version>
  <supportedClientVersions>[3.0.0,5.0.0)</supportedClientVersions>
  <displayName>Aspire Host</displayName>
  <authors>Aryzac IO</authors>
  <priority>0</priority>
  <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
  <defaults>
    <name>NewApplication</name>
    <relativeOutputLocation>${application.name}</relativeOutputLocation>
    <placeInSameDirectory>false</placeInSameDirectory>
    <separateIntentFiles>true</separateIntentFiles>
    <setGitIgnoreEntries>true</setGitIgnoreEntries>
    <createFolderForSolution>true</createFolderForSolution>
  </defaults>
  <componentGroups>
    <group name="Aspire">
      <selectionMode>allow-multiple</selectionMode>
      <components>
        <component id="bfdd6ce0-b443-45cb-8603-a02110d794ec" name="Aspire Host" included="true" required="false">
          <icon type="UrlImagePath" source="data:image/png;base64," />
          <modules>
            <module id="Aryzac.Aspire.Host" version="1.0.0" includeAssets="none">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
            <module id="Intent.VisualStudio.Projects" version="3.9.8-pre.0">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
        <component id="fa308229-3dda-4ef1-bfe6-cb1fbdc39b27" name="Gateway" included="true" required="false">
          <icon type="UrlImagePath" source="data:image/png;base64," />
          <modules>
            <module id="Intent.Modelers.Services" version="4.0.7">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
            <module id="Intent.Metadata.ApiGateway" version="1.0.0-beta.4">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
  </componentGroups>
  <additionalSettings />
  <minimumDependencyVersions>
    <module id="Intent.Common.CSharp" version="3.9.10" />
    <module id="Intent.VisualStudio.Projects" version="3.9.8-pre.0" />
  </minimumDependencyVersions>
</applicationTemplate>