export interface <#= ClassName #> {
<#  foreach (var property in Model.Properties) { #>
    <#=property.Name.ToCamelCase()#><#= property.TypeReference.IsNullable ? "?" : "" #>: <#= this.GetTypeName(property.TypeReference) #>;
<#  } #>
}