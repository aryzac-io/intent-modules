  <templates>
    <template id="Aryzac.HostedService" externalReference="3573527e-5347-4982-9be8-61fd304f594c">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Startup</role>
      <location>Services</location>
    </template>
    <template id="Aryzac.HostedServicesConfiguration" externalReference="1eaae990-20af-4d13-98de-64e8df4f8cc3">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Startup</role>
      <location>Configuration</location>
    </template>
  </templates>
  <decorators></decorators>
  <factoryExtensions></factoryExtensions>
  <moduleSettings></moduleSettings>
  <dependencies>
    <dependency id="Intent.Common" version="3.7.2" />
