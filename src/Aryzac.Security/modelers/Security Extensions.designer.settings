  <scripts>
    <script name="Scope Element Script" id="789ae98c-4b16-49a2-9e77-b15d41eabbb2">
      <script>const commandQueryScopeSettingsStereoTypeId = "59f81e19-6e8d-4da2-a8e6-ec72878d7f42";
const scopeScopeSettingsStereoTypeId = "effde114-12bd-498a-bf44-42f90df0e1ba";
const scopeConfigurationTypeId = "9e98940e-f2f5-4431-b8b5-e4c547eefe78";
const scopeTypeId = "33256cb2-6ac1-48e5-b3dd-75c8e83f156e";
const classTypeId = "04e12b51-ed12-42a3-9667-a6aa81bb6d10";
const scopeVerbTypeId = "561f871a-ac3f-4e82-b2ce-4cc129d7f264";
const queryTypeId = "e71b0662-e29d-4db2-868b-8a12464b25d0";
const commandTypeId = "ccf14eb6-3a55-4d81-b5b9-d27311c70cb9";
const httpSettingsStereoTypeId = "b4581ed2-42ec-4ae2-83dd-dcdd5f0837b6";
const pagedResultsTypeId = "9d3fa7ac-3146-4995-8af1-c3b204065b4e";

function addScopeElement(element) {
    if (!element.hasStereotype(commandQueryScopeSettingsStereoTypeId)) {
        const commandQueryScopeSettingsStereoType = element.addStereotype(
            commandQueryScopeSettingsStereoTypeId
        );

        const pkg = element.getPackage();

        const scopeConfiguration =
            pkg.getChildren(scopeConfigurationTypeId)[0] ||
            createElement(scopeConfigurationTypeId, "Scopes", pkg);

        const scopeVerbs = scopeConfiguration.getChildren(scopeVerbTypeId);
        const readScopeVerb = scopeVerbs.filter(m =&gt; m.getName() === "read")[0];
        const readAllScopeVerb = scopeVerbs.filter(m =&gt; m.getName() === "read-all")[0];
        const createScopeVerb = scopeVerbs.filter(m =&gt; m.getName() === "create")[0];
        const updateScopeVerb = scopeVerbs.filter(m =&gt; m.getName() === "update")[0];
        const deleteScopeVerb = scopeVerbs.filter(m =&gt; m.getName() === "delete")[0];

        const elementAssociations = element.getAssociations();
        if (!elementAssociations || elementAssociations.length === 0) {
            return;
        }

        const associationTarget = elementAssociations[0].typeReference.getType();

        const domainClass =
            associationTarget.specializationId === classTypeId
                ? associationTarget
                : associationTarget.getParent();

        const scopeName = domainClass.getName() || element.getName();
        const scopeKey = toKebabCase(scopeName);

        const scope =
            scopeConfiguration
                .getChildren("Scope")
                .find(m =&gt; toKebabCase(m.getName()) === scopeKey) ||
            createElement(scopeTypeId, scopeKey, scopeConfiguration.id);

        const scopeScopeSettingsStereoType = scope.getStereotype(
            scopeScopeSettingsStereoTypeId
        );

        const resourceProperty = scopeScopeSettingsStereoType.getProperty("Resource");
        resourceProperty.setValue(domainClass.id);

        const scopesProperty = commandQueryScopeSettingsStereoType.getProperty("Scopes");
        let currentScopes = scopesProperty.getValue();

        // Only add this scope if it's not already in the list
        if (!currentScopes.some(s =&gt; s.id === scope.id)) {
            currentScopes.push(scope.id);
        }

        scopesProperty.setValue(JSON.stringify(currentScopes));

        const verbProperty = commandQueryScopeSettingsStereoType.getProperty("Verb");
        if (element.specializationId === commandTypeId) {
            const httpStereotype = element.getStereotype(httpSettingsStereoTypeId);

            const httpVerbProperty = httpStereotype.getProperty("Verb");
            const httpVerb = httpVerbProperty.getValue();

            if (httpVerb === "POST") {
                console.log(JSON.stringify(createScopeVerb));
                verbProperty.setValue(createScopeVerb.id);
            } else if (httpVerb === "PUT" || httpVerb === "PATCH") {
                verbProperty.setValue(updateScopeVerb.id);
            } else if (httpVerb === "DELETE") {
                verbProperty.setValue(deleteScopeVerb.id);
            }
        } else if (element.specializationId === queryTypeId) {
            if (element.typeReference.isCollection || element.typeReference.getType().id === pagedResultsTypeId) {
                verbProperty.setValue(readAllScopeVerb.id);
            } else {
                verbProperty.setValue(readScopeVerb.id);
            }
        }
        verbProperty.focus();
    }
}
</script>
    </script>
  </scripts>
</settings>